# Salin ke .env untuk pengembangan lokal. Jangan commit .env.
DATABASE_URL=postgres://jadwalin:jadwalin@localhost:5433/jadwalin
REDIS_URL=redis://localhost:6379

# Web (apps/web). Buat rahasia sendiri: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Superadmin platform (halaman /admin): email dipisah koma. Akun harus berEmail terverifikasi. Kosong = tidak ada superadmin.
SUPERADMIN_EMAILS=

# Penyimpanan berkas (R2 di produksi; RustFS dari infra/docker-compose.yml untuk lokal)
S3_ENDPOINT=http://localhost:9100
S3_REGION=auto
S3_BUCKET=jadwalin-dev
S3_ACCESS_KEY_ID=jadwalin-dev
S3_SECRET_ACCESS_KEY=jadwalin-dev-secret
S3_FORCE_PATH_STYLE=true

# Email. Kosongkan SMTP_URL di lokal: email dicetak ke log worker. Wajib di produksi.
EMAIL_FROM="jadwalin <noreply@jadwalin.id>"
SMTP_URL=

# Cloudflare Turnstile (perlindungan bot halaman booking publik). Wajib di produksi.
# Kunci UJI Cloudflare (selalu lolos), khusus lokal/CI; di produksi pakai kunci dari dashboard Cloudflare:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backup harian terenkripsi + uji restore (worker). Bucket TERPISAH dari berkas pengguna, kredensial terpisah.
# BACKUP_PASSPHRASE: >= 32 karakter, simpan di pengelola kata sandi DAN salinan luring; kehilangannya = backup tak bisa dibuka.
# PG_BIN_DIR: klien pg_dump/pg_restore yang SEMAJOR dengan server (lihat docs/runbook.md).
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_PASSPHRASE=
BACKUP_VERIFY_DATABASE_URL=
PG_BIN_DIR=

# --- Pembayaran (M7; kosong = mati) ---
# PAYMENT_PROVIDER=midtrans            # fake | midtrans ('fake' dilarang di produksi)
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
# MIDTRANS_ENV=sandbox                 # sandbox | production (harus cocok dengan awalan kunci)
# PAYMENT_FAKE_SECRET=ganti-dengan-rahasia-uji-min-16
