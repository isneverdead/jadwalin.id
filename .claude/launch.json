{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "pnpm@9.15.4",
        "--filter",
        "@jadwalin/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_DIST_DIR=.next-alt",
        "BETTER_AUTH_URL=http://localhost:3001",
        "npx",
        "-y",
        "pnpm@9.15.4",
        "--filter",
        "@jadwalin/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}