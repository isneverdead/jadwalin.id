{
  "name": "@jadwalin/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "ensure-bucket": "tsx --env-file=.env.local src/ensure-bucket.ts",
    "backup": "tsx --env-file=.env.local src/backup/cli.ts",
    "seed-dev": "tsx --env-file=.env.local src/seed-dev.ts"
  },
  "dependencies": {
    "@jadwalin/config": "workspace:*",
    "@jadwalin/core": "workspace:*",
    "@jadwalin/db": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "drizzle-orm": "^0.45.2",
    "@jadwalin/module-tickets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "vite": "^7.3.7"
  }
}
